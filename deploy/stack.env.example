# Environment variables for the Portainer stack (deploy/docker-compose.yml).
# Enter them in Portainer → Stacks → the stack → Environment variables.
# Never commit real values. Generate each secret on the server with:
#   openssl rand -hex 32
# Use hex values: the database password goes into a URL, so special characters would break it.

# PostgreSQL
POSTGRES_USER=app
POSTGRES_DB=app
POSTGRES_PASSWORD=

# Passwords of the database roles the app creates on startup:
#   n8n          n8n's own data (schema "n8n")
#   n8n_app      n8n workflows: credential "Postgres app" (orders read, tickets, KB, logs, chat memory)
#   n8n_readonly manager assistant tool: credential "Postgres readonly" (SELECT on tickets, orders)
N8N_DB_PASSWORD=
N8N_APP_DB_PASSWORD=
N8N_READONLY_DB_PASSWORD=

# Encrypts n8n credentials. Set once and never change it.
N8N_ENCRYPTION_KEY=

# Shared secret: the app sends it as the x-bot-secret header, the n8n Webhook checks it
BOT_SECRET=

# Cloudflare Turnstile secret key (phase H). Leave empty until then: verification is skipped.
# The site key is not set here: it is the GitHub variable NEXT_PUBLIC_TURNSTILE_SITE_KEY.
TURNSTILE_SECRET_KEY=

# Your own email: adds demo orders HT-10501 (like scenario 1) and HT-10502 (like scenario 2)
# so the reply emails reach you. Optional.
DEMO_ORDER_EMAIL=
DEMO_ORDER_NAME=

# Optional
TZ=Europe/Sofia
# Public n8n host for approval form links (default n8n.robodigit.win)
# N8N_PUBLIC_HOST=n8n.robodigit.win
# Set to false to stop n8n from importing n8n/workflows on start
# N8N_AUTOLOAD_WORKFLOWS=true
