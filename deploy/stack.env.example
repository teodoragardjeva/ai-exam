# Environment variables for the Portainer stack (deploy/docker-compose.yml).
# Enter them in Portainer → Stacks → the stack → Environment variables.
# Never commit real values. Generate each secret on the server with:
#   openssl rand -hex 32
# Use hex values: the database password goes into a URL, so special characters would break it.

# PostgreSQL
POSTGRES_USER=app
POSTGRES_DB=app
POSTGRES_PASSWORD=

# Password of the restricted "n8n" database role (created by the app on startup)
N8N_DB_PASSWORD=

# Encrypts n8n credentials. Set once and never change it.
N8N_ENCRYPTION_KEY=

# Shared secret: the app sends it as the x-bot-secret header, the n8n Webhook checks it
BOT_SECRET=

# Cloudflare Turnstile secret key (phase H). Leave empty until then: verification is skipped.
# The site key is not set here: it is the GitHub variable NEXT_PUBLIC_TURNSTILE_SITE_KEY.
TURNSTILE_SECRET_KEY=

# Optional
N8N_VERSION=latest
TZ=Europe/Sofia
