{
  "id": "hometechErrors01",
  "name": "WF-E Error handler (error_log + email)",
  "nodes": [
    {
      "parameters": {},
      "id": "00000000-0000-4000-8000-000000000207",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "operation": "insert",
        "schema": {
          "__rl": true,
          "mode": "list",
          "value": "public",
          "cachedResultName": "public"
        },
        "table": {
          "__rl": true,
          "mode": "list",
          "value": "error_log",
          "cachedResultName": "error_log"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "workflow": "={{ $json.workflow.name }}",
            "node": "={{ $json.execution.lastNodeExecuted || ($json.execution.error && $json.execution.error.node && $json.execution.error.node.name) || null }}",
            "message": "={{ ($json.execution.error && $json.execution.error.message) || 'Unknown error' }}",
            "execution_url": "={{ $json.execution.url || null }}"
          },
          "matchingColumns": [],
          "schema": [
            {
              "id": "workflow",
              "displayName": "workflow",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "node",
              "displayName": "node",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "message",
              "displayName": "message",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "execution_url",
              "displayName": "execution_url",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            }
          ],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        },
        "options": {}
      },
      "id": "00000000-0000-4000-8000-000000000208",
      "name": "Write error_log",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        220,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "postgresAppCred1",
          "name": "Postgres app"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "continueOnFail": true
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE tickets SET status = 'Manual review',\n  status_reason = 'Автоматичната обработка спря с грешка: ' || left($2, 200)\nWHERE n8n_execution_id = $1 AND status = 'New'",
        "options": {
          "queryReplacement": "={{ [ String($('Error Trigger').item.json.execution.id), ($('Error Trigger').item.json.execution.error && $('Error Trigger').item.json.execution.error.message) || 'неизвестна грешка' ] }}"
        }
      },
      "id": "00000000-0000-4000-8000-000000000209",
      "name": "Ticket to manual review",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        440,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "postgresAppCred1",
          "name": "Postgres app"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "continueOnFail": true,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "operation": "select",
        "schema": {
          "__rl": true,
          "mode": "list",
          "value": "public",
          "cachedResultName": "public"
        },
        "table": {
          "__rl": true,
          "mode": "list",
          "value": "app_settings",
          "cachedResultName": "app_settings"
        },
        "returnAll": false,
        "limit": 1,
        "where": {
          "values": [
            {
              "column": "key",
              "condition": "equal",
              "value": "manager_email"
            }
          ]
        },
        "combineConditions": "AND",
        "options": {}
      },
      "id": "00000000-0000-4000-8000-000000000210",
      "name": "Manager email",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        660,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "postgresAppCred1",
          "name": "Postgres app"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "sendTo": "={{ $json.value }}",
        "subject": "=⚠ n8n грешка: {{ $('Error Trigger').item.json.workflow.name }}",
        "emailType": "text",
        "message": "=Workflow: {{ $('Error Trigger').item.json.workflow.name }}\nНод: {{ $('Error Trigger').item.json.execution.lastNodeExecuted }}\nГрешка: {{ $('Error Trigger').item.json.execution.error.message }}\nИзпълнение: {{ $('Error Trigger').item.json.execution.url }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "00000000-0000-4000-8000-000000000211",
      "name": "Notify manager",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        880,
        0
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "gmailAccountCrd1",
          "name": "Gmail account"
        }
      },
      "continueOnFail": true
    }
  ],
  "connections": {
    "Error Trigger": {
      "main": [
        [
          {
            "node": "Write error_log",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Write error_log": {
      "main": [
        [
          {
            "node": "Ticket to manual review",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ticket to manual review": {
      "main": [
        [
          {
            "node": "Manager email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Manager email": {
      "main": [
        [
          {
            "node": "Notify manager",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner"
  },
  "pinData": {}
}
