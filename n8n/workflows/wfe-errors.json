{
  "id": "hometechErrors01",
  "name": "WF-E Error handler (error_log + email)",
  "nodes": [
    {
      "parameters": {},
      "id": "00000000-0000-4000-8000-000000000072",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO error_log (workflow, node, message, execution_url) VALUES ($1, $2, $3, $4)",
        "options": {
          "queryReplacement": "={{ [ $json.workflow.name, $json.execution.lastNodeExecuted || ($json.execution.error && $json.execution.error.node && $json.execution.error.node.name) || null, ($json.execution.error && $json.execution.error.message) || 'Unknown error', $json.execution.url || null ] }}"
        }
      },
      "id": "00000000-0000-4000-8000-000000000073",
      "name": "Write error_log",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        220,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "postgresAppCred1",
          "name": "Postgres app"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "continueOnFail": true
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT value AS manager_email FROM app_settings WHERE key = 'manager_email'",
        "options": {}
      },
      "id": "00000000-0000-4000-8000-000000000074",
      "name": "Manager email",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        440,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "postgresAppCred1",
          "name": "Postgres app"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "sendTo": "={{ $json.manager_email }}",
        "subject": "=⚠ n8n грешка: {{ $('Error Trigger').item.json.workflow.name }}",
        "emailType": "text",
        "message": "=Workflow: {{ $('Error Trigger').item.json.workflow.name }}\nНод: {{ $('Error Trigger').item.json.execution.lastNodeExecuted }}\nГрешка: {{ $('Error Trigger').item.json.execution.error.message }}\nИзпълнение: {{ $('Error Trigger').item.json.execution.url }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "00000000-0000-4000-8000-000000000075",
      "name": "Notify manager",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        660,
        0
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "gmailAccountCrd1",
          "name": "Gmail account"
        }
      },
      "continueOnFail": true
    }
  ],
  "connections": {
    "Error Trigger": {
      "main": [
        [
          {
            "node": "Write error_log",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Write error_log": {
      "main": [
        [
          {
            "node": "Manager email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Manager email": {
      "main": [
        [
          {
            "node": "Notify manager",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner"
  },
  "pinData": {}
}
