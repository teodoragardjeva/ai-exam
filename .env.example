# Template for local development. Do not put real values here: this file is in git.
# `npm run dev:env` copies it to .env.local (git-ignored) and fills every empty
# secret below with a random value. Edit .env.local, never this file.
# The server gets its own secrets in Portainer (deploy/stack.env.example).

# Postgres (docker-compose.dev.yml)
POSTGRES_USER=app
POSTGRES_DB=app
POSTGRES_PASSWORD=

# Used by both n8n and the app
N8N_DB_PASSWORD=
N8N_ENCRYPTION_KEY=
BOT_SECRET=

# Database roles for n8n workflows (credentials "Postgres app" and "Postgres readonly")
N8N_APP_DB_PASSWORD=
N8N_READONLY_DB_PASSWORD=

# Optional: your email gets demo orders HT-10501 and HT-10502 (reply emails reach you)
DEMO_ORDER_EMAIL=
DEMO_ORDER_NAME=

# App (Next.js expands ${...} from the values above)
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}
N8N_WEBHOOK_URL=http://localhost:5678/webhook

# Cloudflare Turnstile. Leave empty to skip the widget locally, or use Cloudflare's
# public test keys from https://developers.cloudflare.com/turnstile/troubleshooting/testing/
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
